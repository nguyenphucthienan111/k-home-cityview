{
  "rewrites": [
    { "source": "/((?!api/|sitemap\\.xml|robots\\.txt|.*\\..*).*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "k-home-dongnai.vercel.app" }],
      "destination": "https://k-homedongnai.com.vn/$1",
      "permanent": true
    },
    { "source": "/projects", "destination": "/san-pham", "permanent": true },
    { "source": "/projects/k-home-cityview-ho-nai",         "destination": "/k-home-cityview-ho-nai",   "permanent": true },
    { "source": "/projects/k-home-midtown-trang-bom",       "destination": "/k-home-midtown-trang-bom", "permanent": true },
    { "source": "/projects/k-home-avenue-nhon-trach",       "destination": "/k-home-avenue-nhon-trach", "permanent": true },
    { "source": "/projects/k-home-cityview-ho-nai/1pn-a",   "destination": "/k-home-cityview-ho-nai/can-1pn-a",   "permanent": true },
    { "source": "/projects/k-home-cityview-ho-nai/1pn-b",   "destination": "/k-home-cityview-ho-nai/can-1pn-b",   "permanent": true },
    { "source": "/projects/k-home-cityview-ho-nai/2pn",     "destination": "/k-home-cityview-ho-nai/can-2pn",     "permanent": true },
    { "source": "/projects/k-home-cityview-ho-nai/3pn",     "destination": "/k-home-cityview-ho-nai/can-3pn",     "permanent": true },
    { "source": "/projects/k-home-midtown-trang-bom/studio","destination": "/k-home-midtown-trang-bom/can-studio", "permanent": true },
    { "source": "/projects/k-home-midtown-trang-bom/1pn-a", "destination": "/k-home-midtown-trang-bom/can-1pn-a",  "permanent": true },
    { "source": "/projects/k-home-midtown-trang-bom/1pn-b", "destination": "/k-home-midtown-trang-bom/can-1pn-b",  "permanent": true },
    { "source": "/projects/k-home-midtown-trang-bom/2pn",   "destination": "/k-home-midtown-trang-bom/can-2pn",    "permanent": true },
    { "source": "/projects/k-home-avenue-nhon-trach/studio","destination": "/k-home-avenue-nhon-trach/can-studio",  "permanent": true },
    { "source": "/projects/k-home-avenue-nhon-trach/1pn",   "destination": "/k-home-avenue-nhon-trach/can-1pn",    "permanent": true },
    { "source": "/projects/k-home-avenue-nhon-trach/2pn-nho","destination": "/k-home-avenue-nhon-trach/can-2pn-nho","permanent": true },
    { "source": "/projects/k-home-avenue-nhon-trach/2pn-lon","destination": "/k-home-avenue-nhon-trach/can-2pn-lon","permanent": true }
  ],
  "functions": {
    "api/contact.ts": { "maxDuration": 30 },
    "api/contacts.ts": { "maxDuration": 30 },
    "api/contacts/[id].ts": { "maxDuration": 30 },
    "api/admin/login.ts": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ]
}
